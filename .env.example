# --- App ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ai_code_review

# --- File storage ---
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25

# NOTE: AI provider credentials (base URL / API key / model) are NOT set here.
# They are configured per-user, at runtime, via the AI Providers API/UI,
# and stored encrypted in the database. See ARCHITECTURE.md.
